# Copy this file to ".env" and fill it in. Never commit .env.

# ---------- Site ----------
BRAND_NAME=Jenny Ashby
PORT=3000
# The public URL of your site (used in emails, referral links and Stripe redirects). Must be your https address in production.
# NEXT_PUBLIC_SITE_URL is accepted as an alias. In production (NODE_ENV=production, or on Render) the server REFUSES TO START
# if this is missing or points at localhost, so an invite link can never be built from a local address.
# (If BASE_URL is left unset outside production, invite links shown on the site fall back to the address the visitor is on.
# Emails and Stripe return pages always use BASE_URL, so still set it before launch.)
BASE_URL=http://localhost:3000
# Set to production when hosting. Render, Railway, Fly.io, Heroku, Vercel and Cloud Run announce themselves, which switches the same checks on.
NODE_ENV=
# Set to true when running behind a proxy/host (Render, Railway, Nginx...) so rate-limiting sees real IPs.
TRUST_PROXY=false
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@JennyAshbyMusic
# Video shown next to the signup form: the ID after "v=" in its YouTube link. Leave the line out to keep the built-in default,
# or set it blank (FEATURED_VIDEO_ID=) to show your channel's newest upload instead.
FEATURED_VIDEO_ID=m6McIfkZy40
# Where the database and email previews (data/outbox) are stored. Point at a persistent disk when hosting.
# DATA_DIR=data
# Private folder for member-exclusive songs (never served as static files). Keep it on the same persistent disk.
# MEMBERS_AUDIO_DIR=data/members-audio
# Biggest exclusive song file the admin upload accepts
MAX_AUDIO_MB=100

# ---------- Stripe ($5/month membership) ----------
# Starts with sk_test_ (test mode) or sk_live_ (real money)
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe (or `stripe listen` locally). Starts with whsec_
STRIPE_WEBHOOK_SECRET=
# Optional: use a Price you created in the Stripe dashboard. If blank, a $5/month price is created at checkout.
STRIPE_PRICE_ID=
PRICE_CENTS=500
CURRENCY=usd

# ---------- Systeme.io (your contact list) ----------
# Systeme.io > Profile > Settings > Public API keys
SYSTEME_API_KEY=
# Tags applied to contacts (created automatically if they don't exist)
SYSTEME_TAG_LEAD=Lead
SYSTEME_TAG_MEMBER=Member
SYSTEME_TAG_CANCELLED=Cancelled
SYSTEME_TAG_UNSUBSCRIBED=Unsubscribed

# ---------- YouTube ----------
# Your channel ID (starts with UC...). YouTube Studio > Settings > Channel > Advanced settings.
YOUTUBE_CHANNEL_ID=UCyEjtqfosikE2LI4SClZBog
# OPTIONAL. With a key the site reads your WHOLE catalog through the YouTube Data API. Without one it uses the channel's
# public feed (newest 15 videos), which already works. Get a key: Google Cloud Console > enable "YouTube Data API v3" > Credentials.
YOUTUBE_API_KEY=
# #Shorts are skipped when picking the weekly songs. Set to true to include them.
INCLUDE_SHORTS=false
SONGS_PER_DROP=3
# How many of the channel's uploads to read (each 50 costs 1 API quota unit)
# YOUTUBE_MAX_VIDEOS=1000
# Which unsent videos to pick first: newest | oldest | random
PICK_MODE=newest

# ---------- Link-in-bio page (/links, alias /bio) and custom chorus ----------
# Defaults are Jenny's real pages. Set a value blank to hide that button.
# SPOTIFY_URL=https://open.spotify.com/artist/1edxigeKoEWQJxJA7tVM3l
# YOUTUBE_MUSIC_URL=https://music.youtube.com/channel/UC2803FvZwlTfxKGXOxKvSMw
# AMAZON_MUSIC_URL=https://music.amazon.com/artists/B0HG3NTJW2/jenny-ashby
CHORUS_PRICE_CENTS=1000
# What buyers are told before they pay: on the chorus page, the home page and in the receipt email. The defaults are below;
# uncomment to change one, or set it blank (CHORUS_REFUND=) to leave that line out. Check these are true for how Jenny works.
# CHORUS_TURNAROUND=within 48 hours
# CHORUS_DELIVERY=A finished audio recording of your chorus (MP3) with the lyrics written out, emailed to you.
# CHORUS_REFUND=Every chorus is written just for you, so all sales are final once your request is in. If yours is late or something is wrong, reply to your confirmation email and we will make it right or refund you.
# You get an email here for every paid custom chorus (needs SMTP set up)
NOTIFY_EMAIL=
# The address fans can write to. Shown in the site footer and on the Privacy page as "Contact". Leave blank to show no contact link.
CONTACT_EMAIL=

# ---------- Monthly Spotify vote ----------
# Rounds are calendar months in TIMEZONE. The top songs win when the month ends; you then add them to Spotify by hand.
WINNERS_PER_MONTH=3
VOTE_CANDIDATES=12
# Votes per person per round
VOTES_FREE=1
VOTES_MEMBER=3
# Your Spotify playlist, shown on the vote pages (optional)
SPOTIFY_PLAYLIST_URL=

# ---------- Tip jar (/tip-jar) ----------
# Quick-pick amounts in dollars, comma separated. People can also type their own amount between the smallest and biggest tip (in cents).
# Tips are one-time payments through Stripe Checkout (needs Stripe set up). You get an email for each one if NOTIFY_EMAIL is set.
TIP_AMOUNTS=3,5,10,25
TIP_MIN_CENTS=100
TIP_MAX_CENTS=100000

# ---------- Music store (songs and albums) ----------
# Put the audio files in the store/ folder (see store/README.txt). Prices are in cents. The store needs Stripe set up.
SONG_PRICE_CENTS=200
ALBUM_PRICE_CENTS=1200
# How many times each purchased file can be downloaded
DOWNLOAD_LIMIT=10
# STORE_DIR=store

# ---------- Email sending (SMTP) ----------
# Works with any SMTP provider: Resend, Postmark, Brevo, Amazon SES, Gmail app password, etc.
# Leave SMTP_HOST empty to save emails to data/outbox instead of sending (great for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=songs@yourdomain.com
FROM_NAME=Jenny Ashby
# Required by anti-spam law (CAN-SPAM) in the footer of marketing email
POSTAL_ADDRESS=

# ---------- Consent, exclusives, runway ----------
# A friend only counts toward an invite once they click the confirm link in their email. Defaults to on when SMTP_HOST is set
# (and off otherwise, because no email can be sent). Set true/false to force it.
# REQUIRE_EMAIL_CONFIRMATION=true
# "New songs before they go public" is only promised once at least this many songs are members-only or early-access
EARLY_ACCESS_MIN_SONGS=5
# Warn when the unsent YouTube videos would run out in fewer than this many weeks (also: npm run runway)
RUNWAY_WARN_WEEKS=8

# ---------- Weekly send ----------
# Cron format: minute hour day-of-month month day-of-week. Default: every Monday 09:00.
SEND_CRON=0 9 * * 1
TIMEZONE=America/New_York
# Free subscribers get a locked teaser each week that pushes them to share or upgrade.
SEND_TO_LEADS=true

# ---------- Admin ----------
# Password for /admin (username can be anything). Leave blank to disable the admin page.
ADMIN_TOKEN=

# Preview the whole site with fake songs and no API keys.
DEV_MOCK=false
